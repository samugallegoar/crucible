# Crucible environment variables. Copy this file to ".env" (which git ignores) and fill in what you use.
# Real environment variables always win over values in ".env". Never commit ".env" or paste a key anywhere else.

# Which data provider "crucible data fetch" uses when --provider is not given.
# One of: yfinance (default, no key needed, unofficial) | tiingo (needs TIINGO_API_KEY).
# CRUCIBLE_DATA_PROVIDER=yfinance

# Tiingo API key. Free account: https://www.tiingo.com (copy the API token from your account page).
# Required only when the provider is tiingo. Sent in a request header, never printed or logged.
TIINGO_API_KEY=
